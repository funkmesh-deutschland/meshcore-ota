+#ifdef MCOTA_ENABLED
+bool MyMesh::mcotaSend(const uint8_t* data, uint32_t len, const uint8_t* path, uint8_t hop_size, uint8_t hops) {
+  mesh::Packet* pkt = createRawData(data, len);
+  if (pkt == NULL) return false;
+  pkt->header &= ~PH_ROUTE_MASK;
+  pkt->header |= ROUTE_TYPE_DIRECT;
+  pkt->path_len = 0;
+  if (hops > 0) {
+    pkt->setPathHashSizeAndCount(hop_size, hops);
+    memcpy(pkt->path, path, (size_t)hop_size * hops);
+  }
+  getTables()->markSeen(pkt);
+  sendPacket(pkt, 8, 0);
+  return true;
+}
+
+uint32_t MyMesh::mcotaAirtime(uint32_t len) {
+  return _radio->getEstAirtimeFor(len + 2);
+}
+
+uint32_t MyMesh::mcotaRandom() {
+  uint32_t value;
+  getRNG()->random((uint8_t*)&value, sizeof(value));
+  return value;
+}
+
+bool MyMesh::mcotaVerify(const uint8_t* pub_key, const uint8_t* sig, const uint8_t* msg, uint32_t len) {
+  mesh::Identity id(pub_key);
+  return id.verify(sig, msg, len);
+}
+
+void MyMesh::mcotaReboot() {
+  board.reboot();
+}
+
+void MyMesh::mcotaProbe() {
+  sendNodeDiscoverReq();
+}
+
+void MyMesh::mcotaCommand(char* command, char* reply) {
+  handleCommand(0, command, reply);
+}
+
+void MyMesh::onRawDataRecv(mesh::Packet* packet) {
+  if (packet->getPathHashCount() == 0) mcota_service.onPacket(packet->payload, packet->payload_len);
+}
+#endif
